{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "@typeonce/oxlint-plugin-ritmo"
  ],
  "categories": {
    "correctness": "off"
  },
  // Type-aware rules run through oxlint-tsgolint, with each file's nearest tsconfig.
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true }]
  },
  "overrides": [
    {
      "files": [
        "packages/*/src/**",
        "integration/**",
        "scripts/**",
        "bench/**"
      ],
      "rules": {
        "ritmo/handle-runtime-result": "error",
        "ritmo/prefix-descriptor-and-system-names": "error",
        "ritmo/no-state-spread": "error"
      }
    },
    {
      "files": [
        "packages/*/src/**",
        "integration/*/**"
      ],
      "rules": {
        "ritmo/use-clock-for-time": "error",
        "ritmo/use-random-for-randomness": "error",
        "ritmo/use-ops-for-math": "error",
        "ritmo/keep-simulation-headless": "error",
        "ritmo/no-infinity-in-simulation-data": "error",
        "ritmo/no-float-timers": "error"
      }
    },
    {
      // Game code only: package sources make their brands, in the constructors the brand stands for.
      "files": [
        "integration/*/**"
      ],
      "rules": {
        "ritmo/no-brand-cast": "error"
      }
    },
    {
      // Package sources check untrusted input defensively, so only game code gets this one.
      "files": [
        "integration/**"
      ],
      "rules": {
        "typescript/no-unnecessary-condition": "error"
      }
    },
    {
      // Type tests cast to build values and bind values only to check that they compile.
      "files": [
        "packages/*/dtslint/**"
      ],
      "rules": {
        "typescript/no-unnecessary-type-assertion": "off",
        "eslint/no-unused-vars": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "coverage/**",
    ".agents/**"
  ]
}
