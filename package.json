{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run",
    "test-types": "node --import tsx scripts/check-type-tests.ts && TSTYCHE_STORE_PATH=.tstyche tstyche --target '>=5.9'",
    "test-types:current": "node --import tsx scripts/check-type-tests.ts && TSTYCHE_STORE_PATH=.tstyche TSTYCHE_TYPESCRIPT_MODULE=typescript6/lib/typescript.js tstyche",
    "check-examples": "node --import tsx scripts/check-examples.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test-types && pnpm check-examples && pnpm test",
    "bench": "node --expose-gc --import tsx scripts/bench.ts",
    "bench:check": "node --expose-gc --import tsx scripts/bench.ts --check",
    "bench:update": "node --expose-gc --import tsx scripts/bench.ts --update",
    "bench:compare": "node --import tsx bench/compare/src/run.ts",
    "bench:types:generate": "node --import tsx packages/core/bench/types/generate.ts",
    "coverage": "vitest --coverage",
    "build": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo && tsc -b tsconfig.packages.json --pretty false",
    "pack:check": "node --import tsx scripts/pack-check.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && node --import tsx scripts/sync-version.ts && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "bench:math": "node --import tsx packages/math/bench/helpers.ts",
    "lint": "oxlint --disable-nested-config"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@typeonce/oxlint-plugin-ritmo": "workspace:*",
    "@typeonce/ritmo": "workspace:*",
    "@typeonce/ritmo-browser": "workspace:*",
    "@typeonce/ritmo-devtools": "workspace:*",
    "@typeonce/ritmo-math": "workspace:*",
    "@typeonce/ritmo-netcode": "workspace:*",
    "@typeonce/ritmo-pixi": "workspace:*",
    "@typeonce/ritmo-render": "workspace:*",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/expect": "4.0.18",
    "arktype": "^2.2.9",
    "effect": "4.1.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2005",
    "pixi.js": "^8.17.1",
    "tstyche": "7.2.3",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "zod": "^4.6.7"
  }
}
