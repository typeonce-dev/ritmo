{
  "name": "@typeonce/ritmo-devtools",
  "version": "0.18.0",
  "description": "Headless debug sessions, trace history, text reports, replays, and fuzzing for Ritmo runtimes",
  "author": "Sandro Maglione",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typeonce-dev/ritmo.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/typeonce-dev/ritmo/issues"
  },
  "homepage": "https://github.com/typeonce-dev/ritmo#readme",
  "keywords": [
    "ecs",
    "gamedev",
    "ritmo",
    "devtools",
    "debugging",
    "agents"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "ritmo-devtools": "./src/cli.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      },
      "./internal/*": null,
      "./*/index": null
    },
    "bin": {
      "ritmo-devtools": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "check": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@typeonce/ritmo": "workspace:^",
    "@typeonce/ritmo-netcode": "workspace:^"
  },
  "peerDependencies": {
    "oxlint": ">=1.86.0",
    "playwright": ">=1.40",
    "rolldown": ">=1.0.0-rc.12",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=22.15"
  }
}
