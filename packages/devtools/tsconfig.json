{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // For the `ritmo-devtools` CLI (src/cli.ts); its declarations export nothing that needs them.
    "types": ["node"],
    // For `Monitor`, the one devtools module that runs on a DOM host.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  "references": [
    { "path": "../core" },
    { "path": "../math" }
  ]
}
