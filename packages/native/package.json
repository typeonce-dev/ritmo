{
  "name": "@typeonce/ritmo-native",
  "version": "0.8.0",
  "description": "QuickJS-ng and SDL3 native hosts and ahead-of-time systems for Ritmo games",
  "author": "Sandro Maglione",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typeonce-dev/ritmo.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/typeonce-dev/ritmo/issues"
  },
  "homepage": "https://github.com/typeonce-dev/ritmo#readme",
  "keywords": [
    "ecs",
    "gamedev",
    "ritmo",
    "devtools",
    "debugging",
    "agents"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "dist",
    "README.md",
    "LICENSE",
    "runtime",
    "vendor",
    "CMakeLists.txt"
  ],
  "bin": {
    "ritmo-native": "./src/cli.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./internal/*": null,
    "./*/index": null,
    "./compiler/*": null
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./compiler/*": null
    },
    "bin": {
      "ritmo-native": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "check": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@typeonce/ritmo": "workspace:^",
    "@typeonce/ritmo-browser": "workspace:^",
    "@typeonce/ritmo-render": "workspace:^",
    "esbuild": "0.27.4",
    "typescript6": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
