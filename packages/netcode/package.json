{
  "name": "@typeonce/ritmo-netcode",
  "version": "0.14.0",
  "description": "Rollback and lockstep sessions over any transport for Ritmo: input timelines, checkpoint history, pacing, resync, and desync checks",
  "author": "Sandro Maglione",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typeonce-dev/ritmo.git",
    "directory": "packages/netcode"
  },
  "bugs": {
    "url": "https://github.com/typeonce-dev/ritmo/issues"
  },
  "homepage": "https://github.com/typeonce-dev/ritmo#readme",
  "keywords": [
    "ecs",
    "gamedev",
    "ritmo",
    "netcode",
    "rollback",
    "multiplayer"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      },
      "./internal/*": null,
      "./*/index": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "check": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@typeonce/ritmo": "workspace:^",
    "@typeonce/ritmo-math": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typeonce/ritmo-browser": "workspace:*",
    "@typeonce/ritmo-devtools": "workspace:*"
  }
}
