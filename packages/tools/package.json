{
  "name": "@typeonce/ritmo-tools",
  "version": "0.19.1",
  "description": "Asset tools for games made with Ritmo, for agents: fixes AI-made pixel art and animation sheets onto a true pixel grid and a palette, keeps game sounds as JSON recipes, and writes game music as JSON songs built around a hum, each with a review page for a person",
  "author": "Sandro Maglione",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typeonce-dev/ritmo.git",
    "directory": "packages/tools"
  },
  "bugs": {
    "url": "https://github.com/typeonce-dev/ritmo/issues"
  },
  "homepage": "https://github.com/typeonce-dev/ritmo#readme",
  "keywords": [
    "gamedev",
    "ritmo",
    "pixel-art",
    "sprite-sheet",
    "sound-effects",
    "music",
    "agents",
    "cli"
  ],
  "type": "module",
  "files": [
    "dist",
    "!dist/pixel/ui",
    "!dist/sound/ui",
    "!dist/music/ui",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "ritmo-tools": "./bin/ritmo-tools.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./pixel/page": "./src/pixel/ui/main.ts",
    "./pixel/page.css": "./src/pixel/ui/style.css",
    "./sound/demo": "./src/sound/ui/demo.ts",
    "./sound/page.css": "./src/sound/ui/style.css",
    "./sound/render": "./src/sound/core/render.ts",
    "./sound/recipe": "./src/sound/core/recipe.ts",
    "./sound/example.json": "./examples/spirit-call.sounds.json",
    "./music/demo": "./src/music/ui/demo.ts",
    "./music/page.css": "./src/music/ui/style.css",
    "./music/render": "./src/music/core/render.ts",
    "./music/song": "./src/music/core/song.ts",
    "./music/example.json": "./examples/village.song.json",
    "./music/example.wav": "./examples/village.song.reference.wav"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json"
    },
    "bin": {
      "ritmo-tools": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false",
    "check": "tsc -b tsconfig.json --pretty false",
    "build:page": "vite build src/sound/ui --outDir ../../../dist/sound/page --emptyOutDir --base ./ --logLevel warn && vite build src/music/ui --outDir ../../../dist/music/page --emptyOutDir --base ./ --logLevel warn",
    "prepack": "pnpm run build:page"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.0",
    "@effect/platform-node-shared": "4.1.0",
    "effect": "4.1.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.21.0",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
