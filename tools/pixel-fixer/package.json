{
  "name": "@typeonce/pixel-fixer",
  "private": true,
  "type": "module",
  "description": "Fixes AI-made or blurry pixel art: finds its pixel grid, snaps each cell to a palette, and exports crisp PNG, SVG, and palette files.",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base ./",
    "preview": "vite preview",
    "pixel": "node bin/pixel.mjs"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.21.0",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "effect": "4.0.6",
    "pngjs": "7.0.0"
  },
  "bin": {
    "pixel": "./bin/pixel.mjs"
  }
}
