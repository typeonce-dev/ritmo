{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/dtslint/**/*.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "rewriteRelativeImportExtensions": false,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@typeonce/ritmo": ["./packages/core/src/index.ts"],
      "@typeonce/ritmo/*": ["./packages/core/src/*"],
      "@typeonce/ritmo-browser": ["./packages/browser/src/index.ts"],
      "@typeonce/ritmo-browser/*": ["./packages/browser/src/*"],
      "@typeonce/ritmo-render": ["./packages/render/src/index.ts"],
      "@typeonce/ritmo-render/*": ["./packages/render/src/*"],
      "@typeonce/ritmo-pixi": ["./packages/pixi/src/index.ts"],
      "@typeonce/ritmo-pixi/*": ["./packages/pixi/src/*"],
      "@typeonce/ritmo-math": ["./packages/math/src/index.ts"],
      "@typeonce/ritmo-math/*": ["./packages/math/src/*"],
      "@typeonce/ritmo-devtools": ["./packages/devtools/src/index.ts"],
      "@typeonce/ritmo-devtools/*": ["./packages/devtools/src/*"],
      "@typeonce/ritmo-native": ["./packages/native/src/index.ts"],
      "@typeonce/ritmo-native/*": ["./packages/native/src/*"]
    }
  }
}
