---
import { brand } from "../brand.ts"
import { repository } from "../nav.ts"
---

<footer class="footer">
  <span class="license">
    <img src={brand.iconInverse.src} alt="" width="18" height="18" />
    <span>Ritmo is MIT licensed</span>
  </span>
  <a href={repository}>GitHub</a>
  <a href="https://www.npmjs.com/package/@typeonce/ritmo">npm</a>
  <a href="/brand/">Brand</a>
  <a href="/tools/">Tools</a>
  <a href="/llms.txt">llms.txt</a>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 28px 24px 40px;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .license {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
  }

  /* The label is as tall as the icon, in whole pixels; the text drops 1px
     so its letters, not its line box, sit on the icon's middle. */
  .license {
    line-height: 18px;
  }

  .license img {
    display: block;
  }

  .license span {
    position: relative;
    top: 1px;
  }

  .footer a {
    color: var(--muted);
  }

  .footer a:hover {
    color: var(--fg);
  }

  :global(:root[data-theme="light"]) .footer img {
    filter: invert(1) hue-rotate(180deg);
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .footer img {
      filter: invert(1) hue-rotate(180deg);
    }
  }
  @media (max-width: 720px) {
    .footer {
      padding: 24px 16px 32px;
    }
  }
</style>
