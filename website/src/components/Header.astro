---
import { brand } from "../brand.ts"
import { repository } from "../nav.ts"

const path = Astro.url.pathname
const links = [
  { href: "/docs/", label: "Docs", active: path.startsWith("/docs/") && !path.startsWith("/docs/packages/") },
  { href: "/docs/packages/", label: "Packages", active: path.startsWith("/docs/packages/") },
  { href: "/tools/", label: "Tools", active: path.startsWith("/tools/") },
  { href: "/examples/", label: "Examples", active: path.startsWith("/examples/") }
]
---

<header class="header">
  <a class="home" href="/" aria-label="Ritmo home">
    <img class="on-dark" src={brand.lockupInverse.src} alt="Ritmo" height="26" />
    <img class="on-light" src={brand.lockup.src} alt="Ritmo" height="26" />
  </a>
  <nav class="links" aria-label="Main">
    {links.map((link) => <a href={link.href} aria-current={link.active ? "page" : undefined}>{link.label}</a>)}
  </nav>
  <div class="tools">
    <button type="button" class="tool search-open" aria-label="Search" title="Search">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M7 2a5 5 0 1 0 3.1 8.9l3 3 1.4-1.4-3-3A5 5 0 0 0 7 2Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z" fill="currentColor"></path></svg>
      <span class="search-label">Search</span>
    </button>
    <button type="button" class="tool theme-toggle" aria-label="Switch light or dark theme" title="Theme">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm0 2v10A5 5 0 0 1 8 3Z" fill="currentColor"></path></svg>
    </button>
    <a class="tool" href={repository} aria-label="Ritmo on GitHub" title="GitHub">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" fill="currentColor"></path></svg>
    </a>
  </div>
</header>

<dialog class="search-dialog" aria-label="Search the docs">
  <div class="search-body">
    <div id="search"></div>
    <p class="search-missing muted" hidden>Search is built with the site: run <code>pnpm build</code> and <code>pnpm preview</code>.</p>
  </div>
</dialog>

<script>
  const root = document.documentElement
  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const current = root.dataset.theme ?? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark")
    const next = current === "light" ? "dark" : "light"
    root.dataset.theme = next
    try {
      localStorage.setItem("ritmo-theme", next)
    } catch {}
  })

  // Pagefind's index exists only in a built site, so its UI loads on first use.
  const dialog = document.querySelector<HTMLDialogElement>(".search-dialog")
  let loaded = false
  const openSearch = async () => {
    if (dialog === null) return
    dialog.showModal()
    if (loaded) {
      dialog.querySelector<HTMLInputElement>("input")?.focus()
      return
    }
    loaded = true
    try {
      const url = "/pagefind/pagefind-ui.js"
      const css = document.createElement("link")
      css.rel = "stylesheet"
      css.href = "/pagefind/pagefind-ui.css"
      document.head.append(css)
      await import(/* @vite-ignore */ url)
      const PagefindUI = (window as unknown as { PagefindUI: new (options: object) => unknown }).PagefindUI
      new PagefindUI({ element: "#search", showSubResults: true, showImages: false, autofocus: true })
    } catch {
      dialog.querySelector(".search-missing")?.removeAttribute("hidden")
    }
  }
  document.querySelector(".search-open")?.addEventListener("click", openSearch)
  document.addEventListener("keydown", (event) => {
    if (event.key === "/" && !(event.target instanceof HTMLInputElement) && !dialog?.open) {
      event.preventDefault()
      void openSearch()
    }
  })
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close()
  })
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header);
    display: flex;
    align-items: center;
    gap: 48px;
    padding: 0 24px;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .home {
    display: flex;
    align-items: center;
  }

  .home img {
    display: block;
    height: 26px;
    width: auto;
  }
  .home img.on-light {
    display: none;
  }
  :global(:root[data-theme="light"]) .home img.on-light {
    display: block;
  }
  :global(:root[data-theme="light"]) .home img.on-dark {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .home img.on-light {
      display: block;
    }
    :global(:root:not([data-theme="dark"])) .home img.on-dark {
      display: none;
    }
  }

  /* Each link is the full height of the bar, so the current page's marker
     sits on the bar's bottom edge. The wordmark's letters sit low in the
     lockup (the dot of the i rises above them), so the text is nudged down
     to line up with them, in whole pixels. */
  .links {
    align-self: stretch;
    display: flex;
    gap: 32px;
    font-family: var(--mono);
    font-size: 0.86rem;
  }

  .links a {
    position: relative;
    display: flex;
    align-items: center;
    padding-top: 6px;
    color: var(--muted);
    text-decoration: none;
  }

  .links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: transparent;
  }

  .links a:hover {
    color: var(--fg);
  }

  .links a[aria-current="page"] {
    color: var(--fg);
  }

  .links a[aria-current="page"]::after {
    background: var(--tick);
  }

  .tools {
    margin-left: auto;
    display: flex;
    gap: 8px;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 10px;
    font: 500 0.82rem var(--mono);
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
    cursor: pointer;
  }

  .tool:hover {
    color: var(--fg);
    border-color: var(--muted);
  }

  .search-dialog {
    width: min(640px, calc(100vw - 32px));
    max-height: min(70vh, 640px);
    margin: 12vh auto auto;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .search-dialog::backdrop {
    background: rgba(14, 16, 19, 0.6);
  }

  .search-body {
    padding: 16px;
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--raised);
    --pagefind-ui-font: var(--sans);
  }

  @media (max-width: 720px) {
    .header {
      gap: 16px;
      padding: 0 16px;
    }
    /* Phones have no room for the links beside the tools: the logo and the home page lead on. */
    .links,
    .search-label {
      display: none;
    }
  }
</style>
