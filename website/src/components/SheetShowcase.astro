---
// What `ritmo-tools pixel sheet` does, drawn: on the left a walk cycle as an
// image generator paints one (soft, each frame a little off in size and
// place, in hand-drawn boxes with labels), on the right the frames found,
// put on one grid and one spot, and played. The frames are the town demo's
// monk (Ninja Adventure, CC0); the soft sheet is drawn from them here.
import monk from "../demos/town/assets/MonkWalk.png"
---

<a class="sheet-showcase" href="/tools/pixel/" aria-label="Open the pixel fixer: a soft, uneven animation sheet becoming frames on one grid, played in place" data-src={monk.src}>
  <canvas aria-hidden="true"></canvas>
</a>

<script>
  /** The walk sheet: 16-pixel frames, one column per direction, one row per frame; the first column walks down. */
  const FRAME = 16
  const FRAMES = 4
  /** How an image generator gets each frame a little wrong: its scale and where it sits in its box. */
  const DRIFT = [
    { scale: 1, x: 0, y: 0 },
    { scale: 1.07, x: 3, y: -2 },
    { scale: 0.95, x: -2, y: 3 },
    { scale: 1.03, x: 2, y: 1 }
  ]
  const FPS = 6

  const link = document.querySelector<HTMLAnchorElement>(".sheet-showcase")
  const canvas = link?.querySelector("canvas")
  const context = canvas?.getContext("2d")

  const start = (image: HTMLImageElement, canvas: HTMLCanvasElement, context: CanvasRenderingContext2D): void => {
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches
    const begin = performance.now()

    const draw = (now: number): void => {
      const ratio = Math.min(2, devicePixelRatio || 1)
      const width = Math.round(canvas.clientWidth * ratio)
      const height = Math.round(canvas.clientHeight * ratio)
      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width
        canvas.height = height
      }
      const style = getComputedStyle(link!)
      const tick = getComputedStyle(document.documentElement).getPropertyValue("--tick").trim() || "#ff5a36"
      const frame = still ? 0 : Math.floor(((now - begin) / 1000) * FPS) % FRAMES
      context.setTransform(1, 0, 0, 1, 0, 0)
      context.clearRect(0, 0, width, height)

      // The sheet: two by two boxes, soft frames, labels under each.
      const pad = Math.round(height * 0.08)
      const box = Math.floor((height - pad * 3) / 2)
      const label = Math.round(box * 0.16)
      const inner = box - label
      context.font = `600 ${Math.round(label * 0.62)}px "JetBrains Mono", monospace`
      context.textAlign = "center"
      for (let i = 0; i < FRAMES; i++) {
        const left = pad + (i % 2) * (box + pad)
        const top = pad + Math.floor(i / 2) * (box + pad)
        const drift = DRIFT[i]!
        const size = inner * 0.78 * drift.scale
        context.save()
        context.imageSmoothingEnabled = true
        context.filter = `blur(${(size / FRAME) * 0.4}px) saturate(1.3)`
        context.drawImage(image, 0, i * FRAME, FRAME, FRAME, left + (box - size) / 2 + drift.x * ratio * 1.5, top + (inner - size) / 2 + drift.y * ratio * 1.5, size, size)
        context.restore()
        context.lineWidth = (i === frame ? 2 : 1) * ratio
        context.strokeStyle = i === frame ? tick : style.borderColor
        context.strokeRect(left + 0.5, top + 0.5, box, box)
        context.fillStyle = i === frame ? tick : style.color
        context.fillText(`walk ${i + 1}`, left + box / 2, top + box - label * 0.32)
      }

      // The fix: the frame on a true grid, on one spot, played.
      const area = width - (pad * 3 + box * 2)
      const scale = Math.max(1, Math.floor(Math.min(area - pad * 2, height - pad * 4) / FRAME))
      const size = FRAME * scale
      const left = pad * 3 + box * 2 + (area - pad - size) / 2
      const top = (height - size) / 2
      context.imageSmoothingEnabled = false
      context.fillStyle = style.borderColor
      for (let x = 0; x <= FRAME; x += 1) context.fillRect(left + x * scale, top, ratio * 0.5, size)
      for (let y = 0; y <= FRAME; y += 1) context.fillRect(left, top + y * scale, size, ratio * 0.5)
      context.drawImage(image, 0, frame * FRAME, FRAME, FRAME, left, top, size, size)
      context.fillStyle = style.color
      context.fillText(`${FRAME} × ${FRAME} · ${FPS} fps`, left + size / 2, top + size + label * 1.1)
      if (!still) requestAnimationFrame(draw)
    }
    requestAnimationFrame(draw)
  }

  if (link !== null && canvas !== undefined && canvas !== null && context !== undefined && context !== null) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer.disconnect()
        const image = new Image()
        image.onload = () => start(image, canvas, context)
        image.src = link.dataset.src!
      },
      { rootMargin: "200px" }
    )
    observer.observe(link)
  }
</script>

<style>
  .sheet-showcase {
    display: block;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 16 / 10;
    margin: 0 auto;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #e8e6e3;
    color: #8a8f98;
    border-color: #c9c5bc;
  }

  .sheet-showcase canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
