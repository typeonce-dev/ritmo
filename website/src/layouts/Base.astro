---
import "../styles/global.css"
import "../styles/twoslash.css"
import "../styles/code.css"

import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import Meta from "../components/Meta.astro"
import TypePopups from "../components/TypePopups.astro"

interface Props {
  title: string
  description?: string
  /** The page's own title alone in the tab, for the home page. */
  bare?: boolean
}

const { title, description = "The all-in-one toolkit for agent-first game development: a type-safe ECS runtime for TypeScript, and everything a game needs around it.", bare = false } = Astro.props
const fullTitle = bare ? title : `${title} · Ritmo`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Meta title={fullTitle} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;700&display=swap"
    />
    <script is:inline>
      // Apply a saved theme choice before the first paint.
      try {
        const saved = localStorage.getItem("ritmo-theme")
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved
      } catch {}
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <TypePopups />
  </body>
</html>
