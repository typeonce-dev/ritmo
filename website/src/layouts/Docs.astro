---
import Base from "./Base.astro"
import { pages, repository, sections, tools } from "../nav.ts"

interface Props {
  frontmatter: {
    title: string
    description?: string
  }
}

const { frontmatter } = Astro.props
const path = Astro.url.pathname
const index = pages.findIndex((page) => page.href === path)
const previous = index > 0 ? pages[index - 1] : undefined
const next = index >= 0 && index < pages.length - 1 ? pages[index + 1] : undefined
const source = Astro.url.pathname === "/docs/" ? "docs/index" : Astro.url.pathname.replace(/^\/|\/$/g, "")
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="docs">
    <aside class="sidebar">
      <details class="menu" open>
        <summary>Menu</summary>
        <nav aria-label="Guide">
          {
            sections.map((section) => (
              <div class="section">
                <p class="section-title">{section.title}</p>
                <ul>
                  {section.pages.map((page) => (
                    <li>
                      <a href={page.href} aria-current={page.href === path ? "page" : undefined}>
                        {page.title}
                      </a>
                    </li>
                  ))}
                  {section.title === "Start" &&
                    tools.map((tool) => (
                      <li>
                        <a class="tool-link" href={tool.href}>
                          {tool.title} <span aria-hidden="true">↗</span>
                        </a>
                      </li>
                    ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>
    </aside>
    <main class="article">
      <article data-pagefind-body>
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="lead">{frontmatter.description}</p>}
        <slot />
      </article>
      <nav class="pager" aria-label="Next and previous pages">
        {
          previous ? (
            <a class="prev" href={previous.href}>
              <span class="muted">Previous</span>
              {previous.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="next" href={next.href}>
              <span class="muted">Next</span>
              {next.title}
            </a>
          )
        }
      </nav>
      <p class="edit">
        <a href={`${repository}/blob/main/website/src/pages/${source}.mdx`}>Edit this page on GitHub</a>
      </p>
    </main>
  </div>
</Base>

<script>
  // The menu starts open on wide screens and closed on a phone.
  const menu = document.querySelector<HTMLDetailsElement>(".menu")
  if (menu !== null && matchMedia("(max-width: 900px)").matches) menu.open = false
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 48px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .sidebar {
    position: sticky;
    top: var(--header);
    align-self: start;
    max-height: calc(100vh - var(--header));
    overflow-y: auto;
    padding: 32px 0;
  }

  .menu summary {
    display: none;
  }

  .section + .section {
    margin-top: 24px;
  }

  .section-title {
    font-family: var(--mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 8px;
  }

  .section ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .section li {
    margin: 0;
  }

  .section a {
    display: block;
    padding: 5px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.93rem;
  }

  .section a:hover {
    color: var(--fg);
  }

  .section a[aria-current="page"] {
    color: var(--fg);
    border-left-color: var(--tick);
    font-weight: 600;
  }

  .article {
    max-width: var(--content);
    padding: 40px 0 64px;
    min-width: 0;
  }

  .lead {
    font-size: 1.12rem;
    color: var(--muted);
    margin-bottom: 2em;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--fg);
    min-width: 0;
  }

  .pager a:hover {
    border-color: var(--tick);
  }

  .pager .muted {
    font-size: 0.75rem;
  }

  .pager .next {
    text-align: right;
    margin-left: auto;
  }

  .edit {
    font-size: 0.85rem;
    margin-top: 24px;
  }

  .edit a {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 0 16px;
    }

    .sidebar {
      position: static;
      max-height: none;
      padding: 16px 0 0;
    }

    .menu summary {
      display: block;
      cursor: pointer;
      font-family: var(--mono);
      font-size: 0.86rem;
      padding: 8px 12px;
      border: 1px solid var(--border);
      border-radius: 6px;
    }

    .menu[open] nav {
      padding: 16px 0 8px;
    }

    .article {
      padding-top: 24px;
    }
  }
</style>
