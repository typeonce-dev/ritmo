---
// The effects lab's review page (packages/tools, `@typeonce/ritmo-tools`) with
// the example bank (a hit, a heavy slash, an explosion, a torch) kept in the
// tab: the page `ritmo-tools fx review` serves, to try without the CLI. Like
// the pixel fixer, it owns the whole window and skips the guide's layout.
import Meta from "../../../components/Meta.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Meta
      title="Effects lab · Ritmo"
      description="Pixel art effects as code: watch a few drafts side by side, pick one, tune it, and pin comments to a pixel. Your coding agent writes and checks them with ritmo-tools fx; you review them here. A free tool from Ritmo."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
    />
  </head>
  <body data-pagefind-ignore="all">
    <div id="app"></div>
    <script>
      // The pixel fixer's and the sound lab's styles first: the tools share one look.
      import "@typeonce/ritmo-tools/pixel/page.css"
      import "@typeonce/ritmo-tools/sound/page.css"
      import "@typeonce/ritmo-tools/fx/page.css"
      import { startDemo } from "@typeonce/ritmo-tools/fx/demo"

      startDemo("heavy-slash")
    </script>
  </body>
</html>
