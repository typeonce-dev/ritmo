---
// The pixel fixer (packages/tools, `@typeonce/ritmo-tools`): a tool page that owns the whole
// window, so it skips the guide's layout. Its page code and styles come from
// the tool's own package; the site only gives it a head and a place to mount.
import Meta from "../../../components/Meta.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Meta
      title="Pixel fixer · Ritmo"
      description="Fixes AI-made or blurry pixel art: finds its pixel grid, snaps each cell to a palette, and exports crisp PNG and SVG. A free tool from Ritmo, the agent-first ECS runtime."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
    />
  </head>
  <body data-pagefind-ignore="all">
    <div id="app"></div>
    <script>
      import "@typeonce/ritmo-tools/pixel/page.css"
      import "@typeonce/ritmo-tools/pixel/page"
    </script>
  </body>
</html>
